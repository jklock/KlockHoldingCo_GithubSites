---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import builds from '../content/site/builds.json';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gear-gallery/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const photos = Object.entries(photoModules)
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([, photo]) => ({ src: photo.default }));
---

<BaseLayout title="Customer Build Photos" description={builds.metaDescription}>
  <header class="page-intro build-intro">
    <div class="shell">
      <p class="eyebrow">{builds.eyebrow}</p>
      <h1>{builds.heading}</h1>
      <p class="lede">{builds.intro}</p>
    </div>
  </header>

  <section class="community-note">
    <div class="shell">
      <h2>{builds.communityHeading}</h2>
      <p>{builds.communityText}</p>
    </div>
  </section>

  <section
    class="section gallery-section"
    aria-label="Klock Holding Co. customer build gallery"
  >
    <div class="shell">
      {photos.length > 0 ? (
        <div class="gear-grid" data-gallery>
          {photos.map((photo, index) => (
            <button
              class="gallery-tile"
              type="button"
              data-gallery-index={index}
              data-full-src={photo.src.src}
              aria-label={`Open customer build photo ${index + 1}`}
            >
              <Image
                src={photo.src}
                alt={`Customer build photo ${index + 1}`}
                widths={[320, 640]}
                sizes="33vw"
                format="webp"
                quality={72}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      ) : (
        <div class="gallery-empty">
          <p class="eyebrow">{builds.emptyEyebrow}</p>
          <h2>{builds.emptyHeading}</h2>
          <p>{builds.emptyText}</p>
        </div>
      )}
    </div>
  </section>

  <dialog
    class="lightbox"
    data-lightbox
    aria-label="Customer build photo viewer"
  >
    <button
      class="lightbox-close"
      type="button"
      data-lightbox-close
      aria-label="Close photo viewer"
    >
      ×
    </button>
    <button
      class="lightbox-nav lightbox-previous"
      type="button"
      data-lightbox-previous
      aria-label="Previous photo"
    >
      ‹
    </button>
    <img data-lightbox-image alt="" />
    <button
      class="lightbox-nav lightbox-next"
      type="button"
      data-lightbox-next
      aria-label="Next photo"
    >
      ›
    </button>
  </dialog>
</BaseLayout>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
    '[data-lightbox-image]',
  );
  const tiles = Array.from(
    gallery?.querySelectorAll<HTMLButtonElement>('[data-gallery-index]') ?? [],
  );
  let currentIndex = 0;

  const showPhoto = (index: number) => {
    if (!lightboxImage || tiles.length === 0) return;

    currentIndex = (index + tiles.length) % tiles.length;
    const tile = tiles[currentIndex];
    lightboxImage.src = tile.dataset.fullSrc ?? '';
    lightboxImage.alt = `Customer build photo ${currentIndex + 1} of ${tiles.length}`;
  };

  tiles.forEach((tile, index) => {
    tile.addEventListener('click', () => {
      if (!lightbox) return;
      showPhoto(index);
      lightbox.showModal();
    });
  });

  lightbox
    ?.querySelector('[data-lightbox-close]')
    ?.addEventListener('click', () => lightbox.close());
  lightbox
    ?.querySelector('[data-lightbox-previous]')
    ?.addEventListener('click', () => showPhoto(currentIndex - 1));
  lightbox
    ?.querySelector('[data-lightbox-next]')
    ?.addEventListener('click', () => showPhoto(currentIndex + 1));

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });

  lightbox?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (event.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
</script>

<style>
  .build-intro h1,
  .build-intro .lede {
    max-width: none;
  }

  .community-note {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-block: 1px solid var(--line);
    background: var(--canvas);
  }

  .community-note .shell {
    display: grid;
    grid-template-columns: minmax(14rem, 0.45fr) minmax(0, 1.55fr);
    gap: 2rem;
    align-items: start;
  }

  .community-note h2,
  .community-note p {
    max-width: none;
    margin-bottom: 0;
  }

  .gear-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .gallery-tile {
    aspect-ratio: 1;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: var(--paper);
    cursor: zoom-in;
    content-visibility: auto;
    contain-intrinsic-size: 320px 320px;
  }

  .gallery-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery-tile:focus-visible {
    outline-offset: 0.25rem;
  }

  .lightbox {
    position: fixed;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgb(0 0 0 / 96%);
    color: white;
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 92%);
  }

  .lightbox img {
    width: 100%;
    height: calc(100dvh - clamp(2rem, 8vw, 6rem));
    object-fit: contain;
  }

  .lightbox button {
    border: 0;
    color: white;
    background: transparent;
    cursor: pointer;
  }

  .lightbox-close {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    font-size: 2.5rem;
    line-height: 1;
  }

  .lightbox-nav {
    padding: 1rem;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
  }

  .gallery-empty {
    width: 100%;
    padding: clamp(1.75rem, 5vw, 4rem);
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .gallery-empty h2 {
    max-width: none;
    margin-bottom: 1rem;
  }

  .gallery-empty p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .community-note .shell {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  @media (max-width: 40rem) {
    .gear-grid {
      gap: 0.5rem;
    }

    .gallery-section {
      padding-block: 2.5rem;
    }

    .lightbox {
      padding: 2.5rem 0.25rem 0.5rem;
    }

    .lightbox img {
      height: calc(100dvh - 3rem);
    }

    .lightbox-nav {
      padding: 0.25rem;
      font-size: 2.5rem;
    }
  }
</style>
