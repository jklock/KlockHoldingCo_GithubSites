---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import builds from '../content/site/builds.json';

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gear-gallery/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const photos = Object.entries(photoModules)
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([path, photo]) => {
    const filename =
      path.split('/').pop() ?? 'Klock Holding Co. customer build';
    const caption = filename
      .replace(/\.[^.]+$/, '')
      .replace(/[-_]+/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase());

    return { caption, src: photo.default };
  });
---

<BaseLayout title="Customer Build Photos" description={builds.metaDescription}>
  <header class="page-intro build-intro">
    <div class="shell">
      <p class="eyebrow">{builds.eyebrow}</p>
      <h1>{builds.heading}</h1>
      <p class="lede">{builds.intro}</p>
    </div>
  </header>

  <section class="community-note">
    <div class="shell">
      <h2>{builds.communityHeading}</h2>
      <p>{builds.communityText}</p>
    </div>
  </section>

  <section
    class="section gallery-section"
    aria-label="Klock Holding Co. customer build gallery"
  >
    <div class="shell">
      {photos.length > 0 ? (
        <div class="gear-grid">
          {photos.map((photo) => (
            <figure>
              <Image
                src={photo.src}
                alt={photo.caption}
                widths={[320, 640]}
                sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
                format="webp"
                quality={72}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="gallery-empty">
          <p class="eyebrow">{builds.emptyEyebrow}</p>
          <h2>{builds.emptyHeading}</h2>
          <p>{builds.emptyText}</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .build-intro h1,
  .build-intro .lede {
    max-width: none;
  }

  .community-note {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-block: 1px solid var(--line);
    background: var(--canvas);
  }

  .community-note .shell {
    display: grid;
    grid-template-columns: minmax(14rem, 0.45fr) minmax(0, 1.55fr);
    gap: 2rem;
    align-items: start;
  }

  .community-note h2,
  .community-note p {
    max-width: none;
    margin-bottom: 0;
  }

  .community-note h2 {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
  }

  .gear-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper);
    content-visibility: auto;
    contain-intrinsic-size: 320px 280px;
  }

  figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  figcaption {
    padding: 0.75rem 0.9rem;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .gallery-empty {
    width: 100%;
    padding: clamp(1.75rem, 5vw, 4rem);
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .gallery-empty h2 {
    max-width: none;
    margin-bottom: 1rem;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
  }

  .gallery-empty p:last-child {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .community-note .shell {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .gear-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .gear-grid {
      grid-template-columns: 1fr;
    }

    .gallery-section {
      padding-block: 2.5rem;
    }
  }
</style>
