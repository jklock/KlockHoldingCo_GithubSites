---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import InlineText from '../components/InlineText.astro';
import builds from '../content/site/builds.json';
import { site } from '../site-config';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/customer-builds/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photosFor = (slug: string) =>
  Object.entries(modules)
    .filter(([path]) => path.includes(`/${slug}/`))
    .sort(([left], [right]) => left.localeCompare(right))
    .map(([, photo]) => photo.default);
const categories = builds.categories.map((category) => ({
  ...category,
  photos: photosFor(category.slug),
}));
const galleryStructuredData = {
  '@type': 'ImageGallery',
  name: 'Klock Holding Co. customer competition gear builds',
  description: builds.metaDescription,
  url: new URL('/gear/', site.url),
  associatedMedia: categories.flatMap((category) =>
    category.photos.map((photo, index) => ({
      '@type': 'ImageObject',
      contentUrl: new URL(photo.src, site.url),
      caption: `${category.name} customer build ${index + 1}`,
    })),
  ),
};
---

<BaseLayout
  title="Customer Competition Gear Build Photos"
  description={builds.metaDescription}
  image={categories.flatMap((category) => category.photos)[0]?.src}
  pageType="CollectionPage"
  structuredData={galleryStructuredData}
>
  <header class="page-intro build-intro">
    <div class="shell">
      <p class="eyebrow">
        <InlineText text={builds.eyebrow} />
      </p>
      <h1>
        <InlineText text={builds.heading} />
      </h1>
      <p class="lede">
        <InlineText text={builds.intro} />
      </p>
    </div>
  </header>
  <section class="community-note">
    <div class="shell">
      <h2>
        <InlineText text={builds.communityHeading} />
      </h2>
      <p>
        <InlineText text={builds.communityText} />
      </p>
    </div>
  </section>
  <section
    class="section gallery-section"
    aria-label="Klock Holding Co. customer build galleries"
  >
    <div class="shell category-list">
      {categories.map((category) => (
        <section id={category.slug} class="build-category">
          <header class="category-heading">
            <button
              class="category-disclosure"
              type="button"
              data-category-disclosure
              aria-controls={`${category.slug}-content`}
              aria-expanded="true"
            >
              <span aria-hidden="true">−</span>
              <span class="sr-only">Collapse {category.name}</span>
            </button>
            <h2>
              <InlineText text={category.name} />
            </h2>
            <span class="category-count">
              {category.photos.length} photo
              {category.photos.length === 1 ? '' : 's'}
            </span>
          </header>
          {category.photos.length > 0 && (
            <div id={`${category.slug}-content`} data-category-content>
              <div id={`${category.slug}-gallery`} class="gear-grid">
                {category.photos.map((photo, index) => (
                  <button
                    class:list={[
                      'gallery-tile',
                      { 'gallery-tile-extra': index >= 4 },
                    ]}
                    type="button"
                    data-gallery-tile
                    data-full-src={photo.src}
                    aria-label={`Open ${category.name} customer build photo ${index + 1}`}
                    hidden={index >= 4}
                  >
                    <Image
                      src={photo}
                      alt={`${category.name} customer build ${index + 1}`}
                      widths={[320, 640]}
                      sizes="(max-width: 62rem) 50vw, 25vw"
                      format="webp"
                      quality={72}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ))}
              </div>
              {category.photos.length > 4 && (
                <button
                  class="gallery-toggle"
                  type="button"
                  data-gallery-toggle
                  aria-controls={`${category.slug}-gallery`}
                  aria-expanded="false"
                  aria-label={`Show all ${category.photos.length} ${category.name} photos`}
                >
                  <span aria-hidden="true">+</span>
                </button>
              )}
            </div>
          )}
        </section>
      ))}
    </div>
  </section>
  <dialog
    class="lightbox"
    data-lightbox
    aria-label="Customer build photo viewer"
  >
    <button
      class="lightbox-close"
      type="button"
      data-lightbox-close
      aria-label="Close photo viewer"
    >
      ×
    </button>
    <button
      class="lightbox-nav lightbox-previous"
      type="button"
      data-lightbox-previous
      aria-label="Previous photo"
    >
      ‹
    </button>
    <img data-lightbox-image alt="" />
    <button
      class="lightbox-nav lightbox-next"
      type="button"
      data-lightbox-next
      aria-label="Next photo"
    >
      ›
    </button>
  </dialog>
</BaseLayout>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
    '[data-lightbox-image]',
  );
  const tiles = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-tile]'),
  );
  let currentIndex = 0;
  const showPhoto = (index: number) => {
    if (!lightboxImage || !tiles.length) return;
    currentIndex = (index + tiles.length) % tiles.length;
    lightboxImage.src = tiles[currentIndex].dataset.fullSrc ?? '';
    lightboxImage.alt = `Customer build photo ${currentIndex + 1} of ${tiles.length}`;
  };
  tiles.forEach((tile, index) =>
    tile.addEventListener('click', () => {
      showPhoto(index);
      lightbox?.showModal();
    }),
  );
  lightbox
    ?.querySelector('[data-lightbox-close]')
    ?.addEventListener('click', () => lightbox.close());
  lightbox
    ?.querySelector('[data-lightbox-previous]')
    ?.addEventListener('click', () => showPhoto(currentIndex - 1));
  lightbox
    ?.querySelector('[data-lightbox-next]')
    ?.addEventListener('click', () => showPhoto(currentIndex + 1));
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) lightbox.close();
  });
  lightbox?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (event.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
  document
    .querySelectorAll<HTMLButtonElement>('[data-gallery-toggle]')
    .forEach((toggle) => {
      const gallery = document.getElementById(
        toggle.getAttribute('aria-controls') ?? '',
      );
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        gallery
          ?.querySelectorAll<HTMLButtonElement>('.gallery-tile-extra')
          .forEach((tile) => {
            tile.hidden = expanded;
          });
        toggle.setAttribute('aria-expanded', String(!expanded));
        toggle.querySelector('[aria-hidden="true"]')!.textContent = expanded
          ? '+'
          : '−';
        toggle.setAttribute(
          'aria-label',
          expanded ? 'Show all photos' : 'Show fewer photos',
        );
      });
    });
  document
    .querySelectorAll<HTMLButtonElement>('[data-category-disclosure]')
    .forEach((toggle) => {
      const content = document.getElementById(
        toggle.getAttribute('aria-controls') ?? '',
      );
      const label = toggle.querySelector('.sr-only');
      const icon = toggle.querySelector('[aria-hidden="true"]');
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        content?.toggleAttribute('hidden', expanded);
        toggle.setAttribute('aria-expanded', String(!expanded));
        if (icon) icon.textContent = expanded ? '>' : '−';
        if (label)
          label.textContent = `${expanded ? 'Expand' : 'Collapse'} category`;
      });
    });
</script>

<style>
  .build-intro h1,
  .build-intro .lede {
    max-width: none;
  }
  .community-note {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-block: 1px solid var(--line);
    background: var(--canvas);
  }
  .community-note .shell {
    display: grid;
    grid-template-columns: minmax(14rem, 0.45fr) minmax(0, 1.55fr);
    gap: 2rem;
    align-items: start;
  }
  .community-note h2,
  .community-note p {
    max-width: none;
    margin-bottom: 0;
  }
  .category-list {
    display: grid;
    gap: 0.75rem;
  }
  .build-category {
    scroll-margin-top: 4rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .category-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem;
  }
  .category-heading h2 {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.35rem);
  }
  .category-disclosure,
  .gallery-toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    padding: 0;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1;
  }
  .category-disclosure:hover,
  .gallery-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .category-count {
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .gear-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0 0 var(--space-4);
  }
  .gallery-tile {
    aspect-ratio: 1;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: var(--canvas);
    cursor: zoom-in;
    content-visibility: auto;
    contain-intrinsic-size: 320px 320px;
  }
  .gallery-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery-toggle {
    margin: 0 1.25rem 1.25rem;
  }
  .lightbox {
    position: fixed;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgb(0 0 0 / 96%);
    color: white;
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 92%);
  }
  .lightbox img {
    width: 100%;
    height: calc(100dvh - clamp(2rem, 8vw, 6rem));
    object-fit: contain;
  }
  .lightbox button {
    border: 0;
    color: white;
    background: transparent;
    cursor: pointer;
  }
  .lightbox-close {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    font-size: 2.5rem;
    line-height: 1;
  }
  .lightbox-nav {
    padding: 1rem;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1;
  }
  @media (max-width: 62rem) {
    .gear-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 56rem) {
    .community-note .shell {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
  @media (max-width: 40rem) {
    .gear-grid {
      gap: var(--space-3);
    }
    .category-heading {
      margin-inline: 0.75rem;
      padding-inline: 0;
    }
    .gallery-toggle {
      margin-inline: 0.75rem;
    }
    .lightbox {
      padding: 2.5rem 0.25rem 0.5rem;
    }
    .lightbox img {
      height: calc(100dvh - 3rem);
    }
    .lightbox-nav {
      padding: 0.25rem;
      font-size: 2.5rem;
    }
  }
</style>
