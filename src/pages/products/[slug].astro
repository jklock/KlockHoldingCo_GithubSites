---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineText from '../../components/InlineText.astro';
import products from '../../content/site/products.json';
import { site } from '../../site-config';

export function getStaticPaths() {
  return products.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const productModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/products/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const buildModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/customer-builds/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photosFor = (
  modules: Record<string, { default: ImageMetadata }>,
  slug: string,
) =>
  Object.entries(modules)
    .filter(([path]) => path.includes(`/${slug}/`))
    .sort(([left], [right]) => left.localeCompare(right))
    .map(([, item]) => item.default);
const productPhotos = photosFor(productModules, product.slug);
const productPhotoTiles = productPhotos.slice(0, 4);
const hasCustomerBuildCategory = true;
const customerPhotos = hasCustomerBuildCategory
  ? photosFor(buildModules, product.slug).slice(0, 4)
  : [];
const youtubeEmbed = product.youtubeUrl
  ? product.youtubeUrl.replace('watch?v=', 'embed/').replace(/&.*$/, '')
  : '';
const structuredData = {
  '@type': 'Product',
  name: product.name,
  description: product.description,
  url: new URL(`/products/${product.slug}/`, site.url),
  image: productPhotos[0] ? new URL(productPhotos[0].src, site.url) : undefined,
};
---

<BaseLayout
  title={product.name}
  description={product.summary}
  image={productPhotos[0]?.src}
  imageAlt={product.photoAlt}
  type="product"
  structuredData={structuredData}
>
  <header class="page-intro">
    <div class="shell product-hero">
      <div class="product-lead-media">
        {productPhotos[0] ? (
          <Image
            src={productPhotos[0]}
            alt={product.photoAlt}
            widths={[720, 1080]}
            sizes="(max-width: 56rem) 100vw, 50vw"
            format="webp"
            quality={80}
            loading="eager"
          />
        ) : (
          <span>Product photos coming soon</span>
        )}
      </div>
      <div>
        <p class="eyebrow">Klock Holding Co. product</p>
        <h1>
          <InlineText text={product.name} />
        </h1>
        <p class="lede">
          <InlineText text={product.summary} />
        </p>
        <div class="hero-actions">
          <a
            class="button"
            href={site.social.pewcentric}
            target="_blank"
            rel="noreferrer"
          >
            Buy on Pewcentric
          </a>
          {product.printablesUrl && (
            <a
              class="text-link"
              href={product.printablesUrl}
              target="_blank"
              rel="noreferrer"
            >
              Print it yourself →
            </a>
          )}
        </div>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="shell">
      <section
        class="product-photo-grid"
        aria-label={`${product.name} product photos`}
      >
        {Array.from({ length: 4 }, (_, index) => productPhotoTiles[index]).map(
          (photo, index) =>
            photo ? (
              <div class="product-photo-tile">
                <Image
                  src={photo}
                  alt={`${product.photoAlt} — view ${index + 1}`}
                  widths={[320, 640]}
                  sizes="(max-width: 40rem) 50vw, 25vw"
                  format="webp"
                  quality={76}
                  loading="lazy"
                />
              </div>
            ) : (
              <div
                class="product-photo-placeholder"
                aria-label={`Product photo ${index + 1} coming soon`}
              >
                Photos coming soon
              </div>
            ),
        )}
      </section>
      <div class="product-details">
        <p class="eyebrow">Why it exists</p>
        <h2>Built to fit your setup—not the other way around.</h2>
        <p>
          <InlineText text={product.description} />
        </p>
      </div>
      <section
        class="product-information"
        aria-label={`${product.name} details`}
      >
        <div>
          <p class="eyebrow">What it changes</p>
          <ul class="benefit-list">
            {product.benefits.map((benefit) => (
              <li>
                <InlineText text={benefit} />
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Specifications</p>
          <dl class="specifications">
            {product.specifications.map(([term, detail]) => (
              <>
                <dt>{term}</dt>
                <dd>{detail}</dd>
              </>
            ))}
          </dl>
        </div>
      </section>
      <section class="configuration-section">
        <p class="eyebrow">Configure with confidence</p>
        <h2>Choose the setup that fits.</h2>
        <ul>
          {product.configuration.map((item) => (
            <li>
              <InlineText text={item} />
            </li>
          ))}
        </ul>
        <p class="purchase-note">
          <InlineText text={product.purchaseNote} />
        </p>
        <div class="product-links">
          <a
            class="button"
            href={site.social.pewcentric}
            target="_blank"
            rel="noreferrer"
          >
            Buy on Pewcentric
          </a>
          {product.printablesUrl && (
            <a
              class="button button-secondary"
              href={product.printablesUrl}
              target="_blank"
              rel="noreferrer"
            >
              View files on Printables
            </a>
          )}
          {product.youtubeUrl && (
            <a
              class="text-link"
              href={product.youtubeUrl}
              target="_blank"
              rel="noreferrer"
            >
              Watch assembly video →
            </a>
          )}
        </div>
      </section>
      {youtubeEmbed && <iframe
        class="product-video"
        src={youtubeEmbed}
        title={`${product.name} on YouTube`}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>}
    </div>
  </section>
  {hasCustomerBuildCategory && (
    <section class="section customer-preview">
      <div class="shell">
        <div class="section-header">
          <h2>Customer builds</h2>
          <p>Builds using this product appear here.</p>
        </div>
        {customerPhotos.length > 0 ? (
          <div class="preview-grid">
            {customerPhotos.map((photo, index) => (
              <a href={`/gear/#${product.slug}`}>
                <Image
                  src={photo}
                  alt={`${product.name} customer build ${index + 1}`}
                  widths={[320, 640]}
                  sizes="(max-width: 56rem) 50vw, 25vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-copy">Customer photos coming soon.</p>
        )}
        <a class="text-link" href={`/gear/#${product.slug}`}>
          View all {product.name} customer builds →
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .product-lead-media {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    min-height: 0;
    place-items: center;
    overflow: hidden;
    background: var(--ink-soft);
    color: #c8c4bd;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }
  .product-lead-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .product-photo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .product-photo-tile,
  .product-photo-placeholder {
    display: grid;
    aspect-ratio: 1;
    min-width: 0;
    overflow: hidden;
    background: var(--ink-soft);
  }
  .product-photo-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-photo-placeholder {
    place-items: center;
    padding: 1rem;
    color: #c8c4bd;
    font-size: clamp(0.55rem, 1.4vw, 0.8rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
  }
  .product-details {
    max-width: 55rem;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .product-details h2 {
    margin-bottom: 1rem;
  }
  .product-details p {
    color: var(--muted);
    font-size: 1.1rem;
  }
  .product-information {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(2rem, 4vw, 4rem);
    border-block: 1px solid var(--line);
  }
  .benefit-list,
  .configuration-section ul {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .benefit-list li,
  .configuration-section li {
    padding-left: 1.35rem;
    position: relative;
  }
  .benefit-list li::before,
  .configuration-section li::before {
    position: absolute;
    left: 0;
    color: var(--accent);
    content: '→';
    font-weight: 800;
  }
  .specifications {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) minmax(0, 1.2fr);
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .specifications dt,
  .specifications dd {
    margin: 0;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .specifications dt {
    color: var(--muted);
    font-weight: 700;
  }
  .configuration-section {
    max-width: 55rem;
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .configuration-section h2 {
    margin-bottom: 1.25rem;
  }
  .purchase-note {
    margin: 1.5rem 0;
    color: var(--muted);
  }
  .product-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .product-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: 2rem;
    border: 0;
  }
  .customer-preview {
    background: var(--paper);
  }
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .preview-grid a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--canvas);
  }
  .preview-grid img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .empty-copy {
    color: var(--muted);
  }
  @media (max-width: 56rem) {
    .product-hero,
    .product-information {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 40rem) {
    .product-photo-grid,
    .preview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
