---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineText from '../../components/InlineText.astro';
import products from '../../content/site/products.json';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/products/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const leadPhoto = (slug: string) =>
  Object.entries(modules)
    .filter(([path]) => path.includes(`/${slug}/`))
    .sort(([left], [right]) => left.localeCompare(right))[0]?.[1].default;
---

<BaseLayout
  title="Products"
  description={products.metaDescription}
  pageType="CollectionPage"
>
  <header class="page-intro">
    <div class="shell">
      <p class="eyebrow">
        <InlineText text={products.eyebrow} />
      </p>
      <h1>
        <InlineText text={products.heading} />
      </h1>
      <p class="lede">
        <InlineText text={products.intro} />
      </p>
    </div>
  </header>
  <section class="section">
    <div class="shell card-grid">
      {products.products.map((product) => {
        const photo = leadPhoto(product.slug);
        return (
          <a class="product-card" href={`/products/${product.slug}/`}>
            {photo ? (
              <div class="product-card-media">
                <Image
                  src={photo}
                  alt={product.photoAlt}
                  widths={[320, 480]}
                  sizes="(max-width: 40rem) 33vw, 18rem"
                  format="webp"
                  quality={76}
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="product-placeholder" aria-hidden="true">
                Photos coming soon
              </div>
            )}
            <span class="product-card-copy">
              <strong>
                <InlineText text={product.name} />
              </strong>
              <span>
                <InlineText text={product.summary} />
              </span>
            </span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .card-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
  }
  .product-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }
  .product-card:hover {
    color: inherit;
    border-color: var(--accent);
  }
  .product-card-media,
  .product-placeholder {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    min-height: 0;
    place-items: center;
    overflow: hidden;
    background: var(--ink-soft);
    color: #c8c4bd;
  }
  .product-card-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-placeholder {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .product-card-copy {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 0.4rem;
    padding: 1.25rem;
  }
  .product-card-copy strong {
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .product-card-copy span {
    color: var(--muted);
  }
  @media (max-width: 62rem) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
