---
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/brand/about-me.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import about from '../content/site/about.json';
---

<BaseLayout
  title="About the Maker"
  description={about.metaDescription}
  image={aboutPhoto.src}
  imageAlt={about.photoAlt}
  pageType="AboutPage"
>
  <header class="about-hero section-dark">
    <div class="shell about-hero-grid">
      <div class="about-intro">
        <p class="eyebrow">{about.heroEyebrow}</p>
        <h1>{about.heroHeading}</h1>
        <p class="lede">{about.heroText}</p>
      </div>
      <Image
        class="about-photo"
        src={aboutPhoto}
        alt={about.photoAlt}
        widths={[640, 960, 1374]}
        sizes="(max-width: 992px) 100vw, 50vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </header>

  <section class="section">
    <article class="shell about-story">
      <div class="story-heading">
        <p class="eyebrow">{about.storyEyebrow}</p>
        <h2>{about.storyHeading}</h2>
      </div>
      <div class="story-copy">
        {about.storyParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <h2>{about.openHeading}</h2>
        {about.openParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .about-intro,
  .about-intro h1,
  .about-intro .lede {
    max-width: none;
  }

  .about-intro h1 {
    margin-bottom: 1.25rem;
  }

  .about-intro .lede {
    margin-bottom: 0;
    color: #c8c4bd;
  }

  .about-photo {
    width: 100%;
    height: auto;
    border: 1px solid #3a3d35;
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 35%);
  }

  .about-story {
    display: grid;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .story-heading {
    position: sticky;
    top: 1.5rem;
  }

  .story-heading h2,
  .story-copy h2 {
    max-width: none;
  }

  .story-copy {
    max-width: none;
    font-size: 1.05rem;
  }

  .story-copy > * + * {
    margin-top: 1.25em;
  }

  .story-copy h2 {
    margin-top: 1.8em;
  }

  @media (max-width: 62rem) {
    .about-hero-grid,
    .about-story {
      grid-template-columns: 1fr;
    }

    .story-heading {
      position: static;
    }
  }

  @media (max-width: 40rem) {
    .about-hero {
      padding-block: 2rem;
    }

    .about-hero-grid {
      gap: 1.5rem;
    }
  }
</style>
