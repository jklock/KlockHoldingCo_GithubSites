---
import { Image } from 'astro:assets';
import aboutPhoto from '../assets/brand/about-me.webp';
import winniePhoto from '../assets/brand/winnie.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import InlineText from '../components/InlineText.astro';
import about from '../content/site/about.json';
---

<BaseLayout
  title="About the Maker"
  description={about.metaDescription}
  image={aboutPhoto.src}
  imageAlt={about.photoAlt}
  pageType="AboutPage"
>
  <header class="about-hero section-dark">
    <div class="shell about-hero-grid">
      <div class="about-intro">
        <p class="eyebrow">
          <InlineText text={about.heroEyebrow} />
        </p>
        <h1>
          <InlineText text={about.heroHeading} />
        </h1>
        <p class="lede">
          <InlineText text={about.heroText} />
        </p>
      </div>
      <Image
        class="about-photo"
        src={aboutPhoto}
        alt={about.photoAlt}
        widths={[640, 960, 1374]}
        sizes="(max-width: 992px) 100vw, 50vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </header>

  <section class="section">
    <article class="shell about-story">
      <div class="story-heading">
        <p class="eyebrow">
          <InlineText text={about.storyEyebrow} />
        </p>
        <h2>
          <InlineText text={about.storyHeading} />
        </h2>
        <div class="winnie-frame">
          <Image
            class="winnie-photo"
            src={winniePhoto}
            alt="Winnie, the Klock Holding Co. dog"
            widths={[480, 720, 960]}
            sizes="(max-width: 992px) 100vw, 35vw"
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
      <div class="story-copy">
        {about.storyParagraphs.map((paragraph) => (
          <p>
            <InlineText text={paragraph} />
          </p>
        ))}
        <h2>
          <InlineText text={about.openHeading} />
        </h2>
        {about.openParagraphs.map((paragraph) => (
          <p>
            <InlineText text={paragraph} />
          </p>
        ))}
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .about-intro,
  .about-intro h1,
  .about-intro .lede {
    max-width: none;
  }

  .about-intro h1 {
    margin-bottom: 1.25rem;
  }

  .about-intro .lede {
    margin-bottom: 0;
    color: #c8c4bd;
  }

  .about-photo {
    width: 100%;
    height: auto;
    border: 1px solid #3a3d35;
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 35%);
  }

  .about-story {
    display: grid;
    grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: stretch;
  }

  .story-heading {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .story-heading h2,
  .story-copy h2 {
    max-width: none;
  }

  .winnie-frame {
    display: flex;
    min-height: 0;
    flex: 1;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .winnie-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .story-copy {
    max-width: none;
    font-size: 1.05rem;
  }

  .story-copy > * + * {
    margin-top: 1.25em;
  }

  .story-copy h2 {
    margin-top: 1.8em;
  }

  @media (max-width: 62rem) {
    .about-hero-grid,
    .about-story {
      grid-template-columns: 1fr;
    }

    .about-story {
      align-items: start;
    }

    .winnie-frame {
      display: block;
      flex: none;
    }

    .winnie-photo {
      height: auto;
    }
  }

  @media (max-width: 40rem) {
    .about-hero {
      padding-block: 2rem;
    }

    .about-hero-grid {
      gap: 1.5rem;
    }
  }
</style>
